#!name=Telegram 加速 v3
#!desc=Telegram 看视频/图片优化：先测各成员到电报 DC 的真实往返，再对前 3 名实测下载吞吐（KB/s），综合挑最快的一条并自动切换；面板显示延迟与吞吐两项实测。脚本走 GitHub 原链。
#!system=ios

[Script]
Telegram自动加速 = type=cron,cronexp="*/10 * * * *",wake-system=true,timeout=60,script-path=https://raw.githubusercontent.com/ty7817/surge-scripts/main/tg-auto.js?v=3
Telegram加速面板 = type=generic,timeout=70,script-path=https://raw.githubusercontent.com/ty7817/surge-scripts/main/tg-panel.js?v=3

[Panel]
Telegram 加速 = script-name=Telegram加速面板,title=Telegram 加速,content=请刷新,update-interval=180,style=info
