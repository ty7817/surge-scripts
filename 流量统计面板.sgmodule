#!name=流量统计面板
#!desc=实时显示上传/下载流量、速度、峰值，点击切换网络界面
#!author=完整版 v3.1
#!system=ios

# ============================================
# 【流量统计面板 功能完整版】
# 保留全部功能，优化稳定性
#
# 功能：
# 1. 上传/下载流量 + 当前速度
# 2. 峰值上传/下载速度
# 3. 点击切换网络界面（WiFi/蜂窝）
# 4. 自动过滤回环网络
#
# 配置：
# - 1秒刷新
# - 3秒超时
# ============================================

[Panel]
流量统计 = script-name=流量统计面板, update-interval=1

[Script]
流量统计面板 = type=generic, timeout=3, script-path=https://cdn.jsdelivr.net/gh/ty7817/surge-scripts@a32e77c8752f4a1988efc811d54a8766ed977e55/traffic-panel.js, argument=icon=gauge&color=#34c759
