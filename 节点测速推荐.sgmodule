[Panel]
节点测速推荐 = script-name=node-recommend, update-interval=0

[Script]
node-recommend = type=generic, timeout=60, script-update-interval=86400, script-path=https://cdn.jsdelivr.net/gh/ty7817/surge-scripts@043606674a6c6b8e1390f1ae25bfaa7554d122d4/node-recommend.js
