[Panel]
节点测速推荐 = script-name=node-recommend, update-interval=0

[Script]
node-recommend = type=generic, timeout=60, script-update-interval=86400, script-path=https://cdn.jsdelivr.net/gh/ty7817/surge-scripts@936da5f411de8be1c21a585ed71933d26ebc86b5/node-recommend.js
