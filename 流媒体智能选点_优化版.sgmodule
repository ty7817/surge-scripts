#!name=流媒体智能选点_优化版
#!desc=根据流媒体需求自动测试节点延迟，切换到最优节点，每天早8点执行
#!author=综合优化版 v1.0
#!category=网络优化
#!date=2026-10-23

# ============================================
# 【流媒体智能选点优化版】
# 功能：根据每个流媒体策略组的需求，自动测试并切换到最合适的节点
#
# 【支持的策略组】
# - 油管视频 → 优先美国/日本节点
# - 奈飞视频 → 优先美国/日本节点
# - TikTok短视频 → 优先美国节点
# - 推特X → 优先美国/日本节点
# - 动漫漫画 → 优先日本节点
# - Emby影院 → 优先美国/日本节点
# - AI服务 → 优先美国节点
# - 电报信息 → 优先新加坡/日本节点
# - 谷歌服务 → 优先美国/日本节点
# - 全球媒体 → 优先美国/日本节点
#
# 【触发方式】
# 每天早上8点自动执行一次（非视频播放时段，不干扰媒体流）
# 也可以通过Surge面板手动触发
#
# 【特点】
# 1. 只在早上8点执行，不干扰视频播放
# 2. 按区域偏好测试节点延迟
# 3. 自动切换到延迟最低的节点
# 4. 切换完成后发送通知
# 5. 无流量触发，不会在看视频时抢占带宽
#
# 【前置要求】
# Surge HTTP API必须开启（你的配置已开启：ty.20040120@127.0.0.1:6171）
# ============================================

[Script]
# 每天早上8点自动执行流媒体选点（非视频播放时段）
streaming-auto-select = type=cron,cronexp=0 8 * * *,script-path=https://cdn.jsdelivr.net/gh/ty7817/surge-scripts@cfd119e86c91071057f3b9bf98ddffd4d231f87a/streaming-auto-select.js,timeout=120,wake-system=1,script-update-interval=86400
