#!name=TG/X 智能选路 v4
#!desc=打开面板即用 telegram / twitter 真实地址测速并自动切换 Telegram / X 分组；自动探测分组名，兼容新旧 profile。依赖 profile 已开启 http-api。
#!system=ios

[Script]
TGX自动选路 = type=cron,cronexp=*/10 * * * *,timeout=120,wake-system=1,script-update-interval=86400,script-path=https://cdn.jsdmirror.com/gh/ty7817/surge-scripts@main/tgx-opt-v2.js
TGX网络切换 = type=event,event-name=network-changed,timeout=120,wake-system=1,script-update-interval=86400,script-path=https://cdn.jsdmirror.com/gh/ty7817/surge-scripts@main/tgx-opt-v2.js
TGX实时面板 = type=generic,timeout=40,script-path=https://cdn.jsdmirror.com/gh/ty7817/surge-scripts@main/tgx-live2.js

[Panel]
TG/X 选路 = script-name=TGX实时面板,title=TG / X 智能选路,content=请刷新,update-interval=300,style=info
