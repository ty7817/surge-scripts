# ===== Telegram MTProto IP段（精确DC段，核心！）=====
# DC1 - 阿姆斯特丹
IP-CIDR,91.108.4.0/22,电报信息,no-resolve
# DC2 - 阿姆斯特丹
IP-CIDR,91.108.8.0/22,电报信息,no-resolve
# DC3 - 阿姆斯特丹
IP-CIDR,91.108.12.0/22,电报信息,no-resolve
# DC4 - 阿姆斯特丹
IP-CIDR,91.108.16.0/22,电报信息,no-resolve
# DC5 - 新加坡
IP-CIDR,91.108.20.0/22,电报信息,no-resolve
# DC6/其他
IP-CIDR,91.108.56.0/22,电报信息,no-resolve
# 通用段
IP-CIDR,149.154.160.0/20,电报信息,no-resolve
IP-CIDR,109.239.140.0/24,电报信息,no-resolve
IP-CIDR,5.28.192.0/18,电报信息,no-resolve
IP-CIDR,139.59.210.98/32,电报信息,no-resolve
IP-CIDR,196.55.216.167/32,电报信息,no-resolve

# ===== Telegram IPv6段 =====
IP-CIDR6,2001:67c:4e8::/48,电报信息,no-resolve
IP-CIDR6,2001:b28:f23c::/47,电报信息,no-resolve
IP-CIDR6,2001:b28:f23f::/48,电报信息,no-resolve
IP-CIDR6,2a0a:f280::/29,电报信息,no-resolve

# ===== Telegram ASN（数据中心自治系统号）=====
IP-ASN,211157,电报信息,no-resolve
IP-ASN,44907,电报信息,no-resolve
IP-ASN,59930,电报信息,no-resolve
IP-ASN,62014,电报信息,no-resolve
IP-ASN,62041,电报信息,no-resolve

# ===== 配置说明 =====
# always-raw-tcp-hosts → Telegram IP走原始TCP，避免HTTP引擎开销（最关键加速）
# tcp-fast-open → 减少TCP握手延迟
# 自动测速选点 → 每10分钟自动切换最快节点
# force-http-engine → 不使用，Telegram客户端用MTProto不用HTTP
# always-real-ip → 不使用，可能导致DNS异常
# MITM → 不使用，WSS不需要解密
# PROCESS-NAME → 不使用，iOS上不生效
# 91.108.0.0/16 → 已拆为6个精确DC段（/22）