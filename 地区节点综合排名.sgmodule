#!name=地区节点综合排名
#!desc=检测每个地区节点的流媒体通过率和延迟，综合评分排名后自动连接最优节点
#!author=定制版 v1.3
#!category=网络优化
#!date=2026-10-23

# ============================================
# 【地区节点流媒体+延迟综合排名】
# 功能：检测每个地区节点的流媒体通过率和延迟
#       综合评分排名后自动连接最优节点
#
# 【测试地区】
# 香港节点、美国节点、日本节点、台湾节点、新加坡节点、韩国节点
#
# 【测试项】
# 1. 延迟测试：generate_204（权重40%）
# 2. 流媒体测试：Netflix/YouTube/Disney+（权重60%）
#
# 【综合评分】
# 评分 = 流媒体通过率 * 60% + 延迟得分 * 40%
#
# 【智能策略】
# 1. 先测试当前节点
# 2. 如果流媒体通过 >= 2个，保持不变
# 3. 如果流媒体通过 < 2个，最多额外测试2个备选节点
# 4. 自动切换到评分最高的节点
#
# 【v1.3更新】
# 1. 新增Wi-Fi/流量切换时自动测试（network-changed事件）
# 2. 定时刷新：0点/8点/12点/20点
#
# 【触发方式】
# 1. 每天0点、8点、12点、20点自动执行（定时）
# 2. Wi-Fi/流量切换时自动执行（网络变化事件）
#
# 【前置要求】
# Surge HTTP API必须开启
# ============================================

[Script]
# 每天0点、8点、12点、20点自动执行（定时）
region-rank = type=cron,cronexp=0 0,8,12,20 * * *,script-path=https://cdn.jsdelivr.net/gh/ty7817/surge-scripts@e73a6960609d44ded72ffa64caec43315c7b512b/region-streaming-rank.js,timeout=300,wake-system=1,script-update-interval=86400

# Wi-Fi/流量切换时自动执行（网络变化事件）
region-rank-network = type=event,event-name=network-changed,script-path=https://cdn.jsdelivr.net/gh/ty7817/surge-scripts@e73a6960609d44ded72ffa64caec43315c7b512b/region-streaming-rank.js,timeout=300,wake-system=1,script-update-interval=86400
