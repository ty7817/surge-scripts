#!name=全局速度优化Pro v3
#!desc=全面优化网络速度v3：基础+DNS+Telegram+Twitter+YouTube+Netflix+TikTok+游戏+谷歌+微软
#!arguments=基础优化:true,DNS优化:true,Telegram优化:true,Twitter优化:true,YouTube优化:true,Netflix优化:true,TikTok优化:true,游戏优化:true,谷歌优化:true,微软优化:true
#!arguments-desc=基础优化：DNS/QUIC/TCP/GeoIP/测试超时；DNS优化：DNS解析加速；Telegram优化：电报播放浏览加速；Twitter优化：推特播放浏览加速；YouTube优化：油管视频加速；Netflix优化：奈飞播放加速；TikTok优化：短视频加速；游戏优化：游戏加速；谷歌优化：谷歌服务加速；微软优化：微软服务加速

[General]
{{#基础优化}}
# ===== 基础速度优化 =====
test-timeout = 3
disable-geoip-db-auto-update = false
block-quic = true
tcp-fast-open = true
predict-alternative-dns-answering = true
udp-policy-not-supported-behaviour = reject
{{/基础优化}}

[Host]
{{#DNS优化}}
# ===== DNS解析优化 =====
# 国内域名用国内DNS
*.taobao.com = server:223.5.5.5
*.tmall.com = server:223.5.5.5
*.alicdn.com = server:223.5.5.5
*.aliyun.com = server:223.5.5.5
*.qq.com = server:119.29.29.29
*.tencent.com = server:119.29.29.29
*.weixin.com = server:119.29.29.29
*.jd.com = server:119.29.29.29
*.bilibili.com = server:119.29.29.29
hdslb.com = server:119.29.29.29
*.mi.com = server:223.5.5.5
*.xiaomi.com = server:223.5.5.5

# 国外域名用加密DNS
google.com = server:https://doh.pub/dns-query
youtube.com = server:https://doh.pub/dns-query
twitter.com = server:https://doh.pub/dns-query
telegram.org = server:https://doh.pub/dns-query
{{/DNS优化}}

[Rule]
{{#Telegram优化}}
# ===== Telegram 播放浏览加速 =====
# Telegram DC IP段优化（确保所有连接走代理）
IP-CIDR,91.108.0.0/16,电报信息,no-resolve
IP-CIDR,149.154.160.0/20,电报信息,no-resolve
IP-CIDR,5.28.192.0/18,电报信息,no-resolve
IP-CIDR,109.239.140.0/24,电报信息,no-resolve
IP-ASN,44907,电报信息,no-resolve
IP-ASN,211157,电报信息,no-resolve

# Telegram CDN域名优化（图片视频加载更快）
DOMAIN-SUFFIX,cdn-telegram.org,电报信息
DOMAIN-SUFFIX,telegram-cdn.org,电报信息
DOMAIN-SUFFIX,telegramdownload.com,电报信息
DOMAIN-SUFFIX,usercontent.dev,电报信息
DOMAIN-SUFFIX,telesco.pe,电报信息
DOMAIN-SUFFIX,comments.app,电报信息
DOMAIN-SUFFIX,graph.org,电报信息

# 屏蔽Telegram QUIC，强制TCP
AND,((DOMAIN-SUFFIX,telegram.org), (PROTOCOL,UDP)),REJECT-NO-DROP
AND,((DOMAIN-SUFFIX,t.me), (PROTOCOL,UDP)),REJECT-NO-DROP
AND,((DOMAIN-SUFFIX,telegram-cdn.org), (PROTOCOL,UDP)),REJECT-NO-DROP
AND,((IP-CIDR,91.108.0.0/16), (PROTOCOL,UDP)),REJECT-NO-DROP
AND,((IP-CIDR,149.154.160.0/20), (PROTOCOL,UDP)),REJECT-NO-DROP
{{/Telegram优化}}

{{#Twitter优化}}
# ===== Twitter/X 播放浏览加速 =====
# Twitter CDN域名优化（图片视频加载更快）
DOMAIN-SUFFIX,twimg.com,推特X
DOMAIN-SUFFIX,twitter.com,推特X
DOMAIN-SUFFIX,x.com,推特X

# Twitter图片CDN精确匹配（确保走代理）
DOMAIN,pbs.twimg.com,推特X
DOMAIN,abs.twimg.com,推特X
DOMAIN,ton.twimg.com,推特X
DOMAIN,video.twimg.com,推特X
DOMAIN,pbs-1.twimg.com,推特X
DOMAIN,cdn.syndication.twimg.com,推特X

# Twitter IP段优化
IP-CIDR,104.244.42.0/24,推特X,no-resolve
IP-CIDR,104.244.43.0/24,推特X,no-resolve
IP-CIDR,199.16.156.0/22,推特X,no-resolve
IP-CIDR,199.59.148.0/22,推特X,no-resolve
{{/Twitter优化}}

{{#YouTube优化}}
# ===== YouTube 播放加速 =====
# YouTube CDN域名优化（视频加载更快）
DOMAIN-SUFFIX,youtube.com,油管视频
DOMAIN-SUFFIX,youtu.be,油管视频
DOMAIN-SUFFIX,googlevideo.com,油管视频
DOMAIN-SUFFIX,youtube-nocookie.com,油管视频

# YouTube视频CDN精确匹配
DOMAIN,manifest.googlevideo.com,油管视频
DOMAIN,redirector.googlevideo.com,油管视频

# YouTube IP段优化
IP-CIDR,173.194.0.0/16,油管视频,no-resolve
IP-CIDR,203.208.0.0/16,油管视频,no-resolve
IP-CIDR,216.58.192.0/19,油管视频,no-resolve
{{/YouTube优化}}

{{#Netflix优化}}
# ===== Netflix 播放加速 =====
# Netflix CDN域名优化
DOMAIN-SUFFIX,netflix.com,奈飞视频
DOMAIN-SUFFIX,netflix.net,奈飞视频
DOMAIN-SUFFIX,nflxvideo.net,奈飞视频
DOMAIN-SUFFIX,nflximg.net,奈飞视频
DOMAIN-SUFFIX,nflximg.com,奈飞视频
DOMAIN-SUFFIX,nflxext.com,奈飞视频
DOMAIN-SUFFIX,nflxso.net,奈飞视频

# Netflix IP段优化
IP-CIDR,3.12.0.0/14,奈飞视频,no-resolve
IP-CIDR,18.184.0.0/15,奈飞视频,no-resolve
IP-CIDR,52.200.0.0/14,奈飞视频,no-resolve
{{/Netflix优化}}

{{#TikTok优化}}
