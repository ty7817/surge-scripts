#!name=全局速度优化Pro v6
#!desc=全面优化网络速度v6：20大模块终极版
#!arguments=基础优化:true,DNS优化:true,Telegram优化:true,Twitter优化:true,YouTube优化:true,Netflix优化:true,TikTok优化:true,游戏优化:true,谷歌优化:true,微软优化:true,B站优化:true,动漫优化:true,Emby优化:true,Discord优化:true,Spotify优化:true,GitHub优化:true,苹果优化:true,RealIP优化:true,通用优化:true,CDN优化:true
#!arguments-desc=基础优化：DNS/QUIC/TCP/GeoIP/测试超时；DNS优化：DNS解析加速；Telegram优化：电报播放浏览加速；Twitter优化：推特播放浏览加速；YouTube优化：油管视频加速；Netflix优化：奈飞播放加速；TikTok优化：短视频加速；游戏优化：游戏加速；谷歌优化：谷歌服务加速；微软优化：微软服务加速；B站优化：哔哩哔哩加速；动漫优化：动漫漫画加速；Emby优化：Emby影院加速；Discord优化：Discord加速；Spotify优化：Spotify音乐加速；GitHub优化：GitHub加速；苹果优化：苹果服务加速；RealIP优化：RealIP补充优化；通用优化：通用速度优化；CDN优化：CDN域名优化

[General]
{{#基础优化}}
# ===== 基础速度优化 =====
test-timeout = 3
disable-geoip-db-auto-update = false
block-quic = true
tcp-fast-open = true
predict-alternative-dns-answering = true
udp-policy-not-supported-behaviour = reject
{{/基础优化}}

{{#RealIP优化}}
# ===== RealIP补充优化 =====
always-real-ip = *.lan, *.direct, cable.auth.com, *.msftconnecttest.com, *.msftncsi.com, network-test.debian.org, detectportal.firefox.com, resolver1.opendns.com, *.srv.nintendo.net, *.stun.playstation.net, xbox.*.microsoft.com, *.xboxlive.com, stun.*, global.turn.twilio.com, global.stun.twilio.com, app.yinxiang.com, injections.adguard.org, local.adguard.org, localhost.*.qq.com, localhost.*.weixin.qq.com, *.logon.battlenet.com.cn, *.logon.battle.net, *.blzstatic.cn, music.163.com, *.music.163.com, *.126.net, musicapi.taihe.com, music.taihe.com, songsearch.kugou.com, trackercdn.kugou.com, *.kuwo.cn, api-jooxtt.sanook.com, api.joox.com, joox.com, y.qq.com, *.y.qq.com, streamoc.music.tc.qq.com, mobileoc.music.tc.qq.com, isure.stream.qqmusic.qq.com, dl.stream.qqmusic.qq.com, aqqmusic.tc.qq.com, amobile.music.tc.qq.com, *.xiami.com, *.music.migu.cn, music.migu.cn, proxy.golang.org, *.mcdn.bilivideo.cn, *.cmpassport.com, id6.me, open.e.189.cn, opencloud.wostore.cn, id.mail.wo.cn, mdn.open.wo.cn, hmrz.wo.cn, nishub1.10010.com, enrichgw.10010.com, *.wosms.cn, *.jegotrip.com.cn, *.icitymobile.mobi, *.pingan.com.cn, *.cmbchina.com, *.10099.com.cn, *.microdone.cn, pool.ntp.org, *.pool.ntp.org, ntp.*.com, time.*.com, ntp?.*.com, time?.*.com, time.*.gov, time.*.edu.cn, *.ntp.org.cn, PDC._msDCS.*.*, DC._msDCS.*.*, GC._msDCS.*.*, *.srv.nintendo.net, *.stun.playstation.net, xbox.*.microsoft.com, *.xboxlive.com, *.battlenet.com.cn, *.battlenet.com, *.blzstatic.cn, *.battle.net, *.turn.twilio.com, *.stun.twilio.com, stun.syncthing.net, stun.*, easy-login.10099.com.cn, *-update.xoyocdn.com, id6.me, open.e.189.cn
{{/RealIP优化}}

{{#通用优化}}
# ===== 通用速度优化 =====
exclude-simple-hostnames = true
use-local-host-item-for-proxy = true
read-etc-hosts = true
{{/通用优化}}

[Host]
{{#DNS优化}}
# ===== DNS解析优化 =====
# 国内域名用国内DNS
*.taobao.com = server:223.5.5.5
*.tmall.com = server:223.5.5.5
*.alicdn.com = server:223.5.5.5
*.aliyun.com = server:223.5.5.5
*.qq.com = server:119.29.29.29
*.tencent.com = server:119.29.29.29
*.weixin.com = server:119.29.29.29
*.jd.com = server:119.29.29.29
*.bilibili.com = server:119.29.29.29
hdslb.com = server:119.29.29.29
*.mi.com = server:223.5.5.5
*.xiaomi.com = server:223.5.5.5

# 国外域名用加密DNS
google.com = server:https://doh.pub/dns-query
youtube.com = server:https://doh.pub/dns-query
twitter.com = server:https://doh.pub/dns-query
telegram.org = server:https://doh.pub/dns-query
{{/DNS优化}}

[Rule]
{{#Telegram优化}}
# ===== Telegram 播放浏览加速 =====
# Telegram DC IP段优化（确保所有连接走代理）
IP-CIDR,91.108.0.0/16,电报信息,no-resolve
IP-CIDR,149.154.160.0/20,电报信息,no-resolve
IP-CIDR,5.28.192.0/18,电报信息,no-resolve
IP-CIDR,109.239.140.0/24,电报信息,no-resolve
IP-ASN,44907,电报信息,no-resolve
IP-ASN,211157,电报信息,no-resolve

# Telegram CDN域名优化（图片视频加载更快）
DOMAIN-SUFFIX,cdn-telegram.org,电报信息
DOMAIN-SUFFIX,telegram-cdn.org,电报信息
DOMAIN-SUFFIX,telegramdownload.com,电报信息
DOMAIN-SUFFIX,usercontent.dev,电报信息
DOMAIN-SUFFIX,telesco.pe,电报信息
DOMAIN-SUFFIX,comments.app,电报信息
DOMAIN-SUFFIX,graph.org,电报信息

# 屏蔽Telegram QUIC，强制TCP
AND,((DOMAIN-SUFFIX,telegram.org), (PROTOCOL,UDP)),REJECT-NO-DROP
AND,((DOMAIN-SUFFIX,t.me), (PROTOCOL,UDP)),REJECT-NO-DROP
AND,((DOMAIN-SUFFIX,telegram-cdn.org), (PROTOCOL,UDP)),REJECT-NO-DROP
AND,((IP-CIDR,91.108.0.0/16), (PROTOCOL,UDP)),REJECT-NO-DROP
AND,((IP-CIDR,149.154.160.0/20), (PROTOCOL,UDP)),REJECT-NO-DROP
{{/Telegram优化}}

{{#Twitter优化}}
# ===== Twitter/X 播放浏览加速 =====
# Twitter CDN域名优化（图片视频加载更快）
DOMAIN-SUFFIX,twimg.com,推特X
DOMAIN-SUFFIX,twitter.com,推特X
DOMAIN-SUFFIX,x.com,推特X

# Twitter图片CDN精确匹配（确保走代理）
DOMAIN,pbs.twimg.com,推特X
DOMAIN,abs.twimg.com,推特X
DOMAIN,ton.twimg.com,推特X
DOMAIN,video.twimg.com,推特X
DOMAIN,pbs-1.twimg.com,推特X
DOMAIN,cdn.syndication.twimg.com,推特X

# Twitter IP段优化
IP-CIDR,104.244.42.0/24,推特X,no-resolve
IP-CIDR,104.244.43.0/24,推特X,no-resolve
IP-CIDR,199.16.156.0/22,推特X,no-resolve
IP-CIDR,199.59.148.0/22,推特X,no-resolve
{{/Twitter优化}}

