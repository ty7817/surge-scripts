#!name=TG/X Node Picker
#!desc=Test Telegram and Twitter latency for all nodes
#!version=2.0

[Script]
tgx-picker = type=generic,timeout=60,script-path=https://raw.githubusercontent.com/ty7817/surge-scripts/main/TgTwitterNodePicker.js

[Panel]
tgx-panel = script-name=tgx-picker,title=TG/X 节点推荐,content=点击刷新开始测速,icon=target,icon-color=#ff9500,update-interval=600