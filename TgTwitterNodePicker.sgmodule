#!name=TG/X节点测速
#!desc=自动测试所有节点访问Telegram和Twitter的延迟，综合排名推荐最优节点
#!version=3.0

[Script]
tgx-picker=type=generic,timeout=120,script-path=https://raw.githubusercontent.com/ty7817/surge-scripts/main/TgTwitterNodePicker.js

[Panel]
TGX面板=script-name=tgx-picker,title=TG/X节点推荐,content=点击刷新开始测速,update-interval=600