#!name=TGX Node Speed Test
#!desc=Test Telegram and Twitter latency
#!version=1.0

[Script]
tgx-picker = type=generic,timeout=60,script-path=https://raw.githubusercontent.com/ty7817/surge-scripts/main/TgTwitterNodePicker.js

[Panel]
tgx-panel = script-name=tgx-picker,title=TG/X Speed Test,content=Please refresh,update-interval=300